# Versand des Kontaktformulars ueber Resend. Der Schluessel gehoert beim
# Hoster in die Umgebung und niemals in das Repo.
RESEND_API_KEY=

# Empfaenger der Anfragen. Ohne Eintrag gilt die Adresse aus app/content.ts.
ANFRAGE_EMPFAENGER=lukas.sehorz@schconsult.de

# Absender, sobald die eigene Domain bei Resend geprueft ist, zum Beispiel
# "SVH Consulting <anfrage@svh-consulting.de>". Ohne Eintrag gilt die
# Testadresse von Resend, die nur an das eigene Resend-Konto senden darf.
ANFRAGE_ABSENDER=
